<?xml version="1.0" encoding="UTF-8"?>
<!--
  Tasker Task: UPI to Splitwise
  ==============================
  IMPORT INSTRUCTIONS:
    1. Long-press the Tasks tab in Tasker
    2. Tap "Import Task"
    3. Select this file
    4. Link it to the "UPI Payment Detected" profile

  PRE-REQUISITES — Set these as Tasker Global Variables BEFORE first use:
    %SPLITWISE_API_KEY   Your Splitwise API key
                         Get it at: https://secure.splitwise.com/apps
    %MAKE_WEBHOOK_URL    Your make.com Custom Webhook URL
                         (from Module 1 of the make.com scenario)

  To set globals in Tasker:
    Menu (3 dots) → Preferences → Variables tab → + button

  FLOW:
    1. Parse UPI amount from SMS body
    2. Parse merchant name from SMS body (used as default description)
    3. Fetch Splitwise groups directly from Splitwise API
    4. Dialog: user selects group
    5. Dialog: user confirms/edits amount and description
    6. Dialog: user selects split method
    7. (If split_selected_equally) Dialog: sequential person selection
    8. POST JSON payload to make.com webhook
    9. Show notification with result

  VARIABLES USED:
    %SMSRB              Built-in Tasker var: body of the received SMS
    %upi_amount         Extracted amount (e.g. "500.00")
    %upi_merchant       Extracted merchant/VPA (e.g. "merchant@okaxis")
    %groups_response    Raw JSON from Splitwise API
    %selected_group     Group chosen by user
    %confirmed_amount   Confirmed/edited amount
    %confirmed_desc     Confirmed/edited description
    %split_method       "equal" or "split_selected_equally"
    %selected_people    Comma-separated names (for split_selected_equally)
    %json_payload       Final JSON string to POST to make.com
    %make_response      Raw JSON response from make.com
-->
<TaskerData sr="" dvi="1" tv="6.2.3-beta">
  <Task sr="task1">
    <cdate>1700000000000</cdate>
    <edate>1700000000000</edate>
    <id>1</id>
    <nme>UPI to Splitwise</nme>
    <pri>100</pri>

    <!-- ============================================================
         ACTION 1: Extract amount from SMS body using regex
         ============================================================
         Tasker Variable Search Replace:
           Variable:    %SMSRB  (the full SMS text)
           Search:      (?i)(?:rs\.?\s*|inr\s*)([\d,]+(?:\.\d+)?)
           Ignore Case: true
           Multi-Line:  false
         The captured group 1 lands in %upi_amount1 after the action.
    -->
    <Action sr="act1" ve="7">
      <code>547</code>
      <!-- Variable Search Replace -->
      <Str sr="arg0" ve="3" val="%SMSRB" />
      <!-- Search regex (amount capture group) -->
      <Str sr="arg1" ve="3" val="(?i)(?:rs\.?\s*|inr\s*)([\d,]+(?:\.\d+)?)" />
      <!-- Replace with nothing (we use match groups) -->
      <Str sr="arg2" ve="3" val="" />
      <Int sr="arg3" val="0" />
      <Int sr="arg4" val="1" />
      <!-- Store match 1 in %upi_amount -->
      <Str sr="arg5" ve="3" val="%upi_amount" />
      <Int sr="arg6" val="0" />
    </Action>

    <!-- ============================================================
         ACTION 2: Remove commas from amount (e.g. "1,500" → "1500")
    -->
    <Action sr="act2" ve="7">
      <code>547</code>
      <Str sr="arg0" ve="3" val="%upi_amount" />
      <Str sr="arg1" ve="3" val="," />
      <Str sr="arg2" ve="3" val="" />
      <Int sr="arg3" val="0" />
      <Int sr="arg4" val="0" />
      <Str sr="arg5" ve="3" val="" />
      <Int sr="arg6" val="0" />
    </Action>

    <!-- ============================================================
         ACTION 3: Extract merchant/VPA from SMS
         Tries to capture UPI VPA (e.g. merchant@okaxis)
         Falls back to empty string — user edits in dialog.
    -->
    <Action sr="act3" ve="7">
      <code>547</code>
      <Str sr="arg0" ve="3" val="%SMSRB" />
      <!-- Matches "to merchant@upi" or "VPA merchant@upi" -->
      <Str sr="arg1" ve="3" val="(?i)(?:to|vpa)\s+([A-Za-z0-9._\-]+(?:@[A-Za-z0-9._]+)?)" />
      <Str sr="arg2" ve="3" val="" />
      <Int sr="arg3" val="0" />
      <Int sr="arg4" val="1" />
      <Str sr="arg5" ve="3" val="%upi_merchant" />
      <Int sr="arg6" val="0" />
    </Action>

    <!-- ============================================================
         ACTION 4: Fallback — if amount couldn't be parsed, abort
    -->
    <Action sr="act4" ve="7">
      <code>37</code>
      <!-- If action (condition check) -->
      <ConditionList sr="if">
        <Condition sr="c0" ve="3">
          <lhs>%upi_amount</lhs>
          <op>1</op>
          <!-- op 1 = "eq" (equals) -->
          <rhs></rhs>
        </Condition>
      </ConditionList>
    </Action>

    <Action sr="act5" ve="7">
      <!-- Flash toast: could not parse -->
      <code>524</code>
      <Str sr="arg0" ve="3" val="Could not parse UPI amount from SMS. Task stopped." />
      <Int sr="arg1" val="1" />
    </Action>

    <Action sr="act6" ve="7">
      <!-- Stop task -->
      <code>145</code>
      <Int sr="arg0" val="0" />
      <Int sr="arg1" val="1" />
    </Action>

    <Action sr="act7" ve="7">
      <!-- End If -->
      <code>38</code>
    </Action>

    <!-- ============================================================
         ACTION 8: Fetch Splitwise groups directly from Splitwise API
         HTTP GET https://secure.splitwise.com/api/v3.0/get_groups
         Header: Authorization: Bearer %SPLITWISE_API_KEY
    -->
    <Action sr="act8" ve="7">
      <code>339</code>
      <!-- HTTP Request -->
      <Str sr="arg0" ve="3" val="GET" />
      <Str sr="arg1" ve="3" val="https://secure.splitwise.com/api/v3.0/get_groups" />
      <!-- Headers: Authorization -->
      <Str sr="arg2" ve="3" val="Authorization:Bearer %SPLITWISE_API_KEY" />
      <!-- No request body for GET -->
      <Str sr="arg3" ve="3" val="" />
      <!-- Content-Type (not needed for GET) -->
      <Str sr="arg4" ve="3" val="" />
      <!-- Output variable -->
      <Str sr="arg5" ve="3" val="%groups_response" />
      <Int sr="arg6" val="0" />
      <Int sr="arg7" val="30" />
    </Action>

    <!-- ============================================================
         ACTION 9: Parse group names from JSON response using JavaScriptlet
         Builds a newline-separated string of group names stored in %groups_list
    -->
    <Action sr="act9" ve="7">
      <code>664</code>
      <!-- JavaScriptlet -->
      <Str sr="arg0" ve="3" val="
var resp = JSON.parse(groups_response);
var names = resp.groups
  .filter(function(g) { return g.id !== 0 &amp;&amp; g.members.length > 0; })
  .map(function(g) { return g.name; });
setLocal('groups_list', names.join('\n'));
setLocal('groups_json', groups_response);
      " />
      <Str sr="arg1" ve="3" val="groups_response" />
      <Str sr="arg2" ve="3" val="groups_list,groups_json" />
      <Int sr="arg3" val="0" />
    </Action>

    <!-- ============================================================
         ACTION 10: Split groups_list into array %groups_arr
    -->
    <Action sr="act10" ve="7">
      <code>547</code>
      <!-- Variable Split -->
      <Str sr="arg0" ve="3" val="%groups_list" />
      <Str sr="arg1" ve="3" val="\n" />
      <Str sr="arg2" ve="3" val="%groups_arr" />
    </Action>

    <!-- ============================================================
         ACTION 11: Dialog — Select Splitwise Group (Menu)
    -->
    <Action sr="act11" ve="7">
      <code>511</code>
      <!-- Menu -->
      <Str sr="arg0" ve="3" val="Select Splitwise Group" />
      <Str sr="arg1" ve="3" val="%groups_arr()" />
      <Str sr="arg2" ve="3" val="%selected_group" />
      <Int sr="arg3" val="1" />
    </Action>

    <!-- ============================================================
         ACTION 12: Dialog — Confirm/edit Amount
    -->
    <Action sr="act12" ve="7">
      <code>545</code>
      <!-- Input Dialog -->
      <Str sr="arg0" ve="3" val="Confirm Amount (₹)" />
      <Str sr="arg1" ve="3" val="%upi_amount" />
      <Str sr="arg2" ve="3" val="%confirmed_amount" />
      <Str sr="arg3" ve="3" val="" />
      <Int sr="arg4" val="0" />
      <Int sr="arg5" val="3" />
    </Action>

    <!-- ============================================================
         ACTION 13: Dialog — Confirm/edit Description
    -->
    <Action sr="act13" ve="7">
      <code>545</code>
      <Str sr="arg0" ve="3" val="Description" />
      <Str sr="arg1" ve="3" val="%upi_merchant" />
      <Str sr="arg2" ve="3" val="%confirmed_desc" />
      <Str sr="arg3" ve="3" val="" />
      <Int sr="arg4" val="0" />
      <Int sr="arg5" val="0" />
    </Action>

    <!-- ============================================================
         ACTION 14: Dialog — Select Split Method (Menu)
    -->
    <Action sr="act14" ve="7">
      <code>511</code>
      <Str sr="arg0" ve="3" val="Split Method" />
      <Str sr="arg1" ve="3" val="Equal Split
Split Selected Equally" />
      <Str sr="arg2" ve="3" val="%split_method_label" />
      <Int sr="arg3" val="1" />
    </Action>

    <!-- ============================================================
         ACTION 15: Normalize split_method to API value
    -->
    <Action sr="act15" ve="7">
      <code>37</code>
      <ConditionList sr="if">
        <Condition sr="c0" ve="3">
          <lhs>%split_method_label</lhs>
          <op>0</op>
          <rhs>Equal Split</rhs>
        </Condition>
      </ConditionList>
    </Action>

    <Action sr="act16" ve="7">
      <code>547</code>
      <Str sr="arg0" ve="3" val="%split_method" />
      <Str sr="arg1" ve="3" val=".*" />
      <Str sr="arg2" ve="3" val="equal" />
      <Int sr="arg3" val="0" />
      <Int sr="arg4" val="0" />
      <Str sr="arg5" ve="3" val="" />
      <Int sr="arg6" val="0" />
    </Action>

    <!-- Variable Set %split_method = equal -->
    <Action sr="act17" ve="7">
      <code>547</code>
      <Str sr="arg0" ve="3" val="%split_method" />
      <Str sr="arg1" ve="3" val=".*" />
      <Str sr="arg2" ve="3" val="equal" />
      <Int sr="arg3" val="0" />
      <Int sr="arg4" val="0" />
      <Str sr="arg5" ve="3" val="" />
      <Int sr="arg6" val="0" />
    </Action>

    <Action sr="act18" ve="7">
      <!-- Else -->
      <code>39</code>
    </Action>

    <!-- Variable Set %split_method = split_selected_equally -->
    <Action sr="act19" ve="7">
      <code>547</code>
      <Str sr="arg0" ve="3" val="%split_method" />
      <Str sr="arg1" ve="3" val=".*" />
      <Str sr="arg2" ve="3" val="split_selected_equally" />
      <Int sr="arg3" val="0" />
      <Int sr="arg4" val="0" />
      <Str sr="arg5" ve="3" val="" />
      <Int sr="arg6" val="0" />
    </Action>

    <Action sr="act20" ve="7">
      <!-- End If -->
      <code>38</code>
    </Action>

    <!-- ============================================================
         ACTIONS 21–30: People selection (only for split_selected_equally)
         Sequential loop: pick one person, ask "add more?"
    -->
    <Action sr="act21" ve="7">
      <code>37</code>
      <ConditionList sr="if">
        <Condition sr="c0" ve="3">
          <lhs>%split_method</lhs>
          <op>0</op>
          <rhs>split_selected_equally</rhs>
        </Condition>
      </ConditionList>
    </Action>

    <!-- Fetch members for selected group -->
    <Action sr="act22" ve="7">
      <code>339</code>
      <Str sr="arg0" ve="3" val="GET" />
      <!-- Build URL with group_name query param -->
      <Str sr="arg1" ve="3" val="https://secure.splitwise.com/api/v3.0/get_groups" />
      <Str sr="arg2" ve="3" val="Authorization:Bearer %SPLITWISE_API_KEY" />
      <Str sr="arg3" ve="3" val="" />
      <Str sr="arg4" ve="3" val="" />
      <Str sr="arg5" ve="3" val="%members_response" />
      <Int sr="arg6" val="0" />
      <Int sr="arg7" val="30" />
    </Action>

    <!-- Parse members from response via JavaScriptlet -->
    <Action sr="act23" ve="7">
      <code>664</code>
      <Str sr="arg0" ve="3" val="
var resp = JSON.parse(members_response);
var selectedGroupName = selected_group.toLowerCase().replace(/\s+/g, '');
var group = resp.groups.find(function(g) {
  return g.name.toLowerCase().replace(/\s+/g, '').indexOf(selectedGroupName) !== -1;
});
var memberNames = group ? group.members.map(function(u) {
  return u.last_name ? u.first_name + ' ' + u.last_name : u.first_name;
}) : [];
setLocal('members_list', memberNames.join('\n'));
      " />
      <Str sr="arg1" ve="3" val="members_response,selected_group" />
      <Str sr="arg2" ve="3" val="members_list" />
      <Int sr="arg3" val="0" />
    </Action>

    <!-- Split members into array -->
    <Action sr="act24" ve="7">
      <code>547</code>
      <Str sr="arg0" ve="3" val="%members_list" />
      <Str sr="arg1" ve="3" val="\n" />
      <Str sr="arg2" ve="3" val="%members_arr" />
    </Action>

    <!-- Initialize selected_people and loop control -->
    <Action sr="act25" ve="7">
      <code>547</code>
      <Str sr="arg0" ve="3" val="%selected_people" />
      <Str sr="arg1" ve="3" val=".*" />
      <Str sr="arg2" ve="3" val="" />
      <Int sr="arg3" val="0" />
      <Int sr="arg4" val="0" />
      <Str sr="arg5" ve="3" val="" />
      <Int sr="arg6" val="0" />
    </Action>

    <Action sr="act26" ve="7">
      <code>547</code>
      <Str sr="arg0" ve="3" val="%add_more_people" />
      <Str sr="arg1" ve="3" val=".*" />
      <Str sr="arg2" ve="3" val="yes" />
      <Int sr="arg3" val="0" />
      <Int sr="arg4" val="0" />
      <Str sr="arg5" ve="3" val="" />
      <Int sr="arg6" val="0" />
    </Action>

    <!-- WHILE add_more_people = yes -->
    <Action sr="act27" ve="7">
      <code>40</code>
      <!-- While -->
      <ConditionList sr="while">
        <Condition sr="c0" ve="3">
          <lhs>%add_more_people</lhs>
          <op>0</op>
          <rhs>yes</rhs>
        </Condition>
      </ConditionList>
    </Action>

    <!-- Menu: pick a person or "Done" -->
    <Action sr="act28" ve="7">
      <code>511</code>
      <Str sr="arg0" ve="3" val="Select person to split with
(so far: %selected_people)" />
      <Str sr="arg1" ve="3" val="%members_arr()
--- Done ---" />
      <Str sr="arg2" ve="3" val="%picked_person" />
      <Int sr="arg3" val="1" />
    </Action>

    <!-- If "Done" selected, stop the loop -->
    <Action sr="act29" ve="7">
      <code>37</code>
      <ConditionList sr="if">
        <Condition sr="c0" ve="3">
          <lhs>%picked_person</lhs>
          <op>0</op>
          <rhs>--- Done ---</rhs>
        </Condition>
      </ConditionList>
    </Action>

    <Action sr="act30" ve="7">
      <code>547</code>
      <Str sr="arg0" ve="3" val="%add_more_people" />
      <Str sr="arg1" ve="3" val=".*" />
      <Str sr="arg2" ve="3" val="no" />
      <Int sr="arg3" val="0" />
      <Int sr="arg4" val="0" />
      <Str sr="arg5" ve="3" val="" />
      <Int sr="arg6" val="0" />
    </Action>

    <Action sr="act31" ve="7">
      <!-- Else: append person to list -->
      <code>39</code>
    </Action>

    <!-- Append picked_person to selected_people (comma-separated) -->
    <Action sr="act32" ve="7">
      <code>664</code>
      <Str sr="arg0" ve="3" val="
var current = selected_people;
var picked = picked_person;
if (current === '') {
  setLocal('selected_people', picked);
} else {
  setLocal('selected_people', current + ',' + picked);
}
      " />
      <Str sr="arg1" ve="3" val="selected_people,picked_person" />
      <Str sr="arg2" ve="3" val="selected_people" />
      <Int sr="arg3" val="0" />
    </Action>

    <Action sr="act33" ve="7">
      <!-- End If -->
      <code>38</code>
    </Action>

    <!-- End While -->
    <Action sr="act34" ve="7">
      <code>41</code>
    </Action>

    <!-- End If (split_selected_equally) -->
    <Action sr="act35" ve="7">
      <code>38</code>
    </Action>

    <!-- ============================================================
         ACTION 36: Build JSON payload using JavaScriptlet
    -->
    <Action sr="act36" ve="7">
      <code>664</code>
      <Str sr="arg0" ve="3" val="
var payload = {
  api_key: global('SPLITWISE_API_KEY'),
  group_name: local('selected_group'),
  amount: local('confirmed_amount'),
  description: local('confirmed_desc'),
  split_method: local('split_method')
};
if (local('split_method') === 'split_selected_equally') {
  payload.selected_people = local('selected_people');
}
setLocal('json_payload', JSON.stringify(payload));
      " />
      <Str sr="arg1" ve="3" val="selected_group,confirmed_amount,confirmed_desc,split_method,selected_people" />
      <Str sr="arg2" ve="3" val="json_payload" />
      <Int sr="arg3" val="0" />
    </Action>

    <!-- ============================================================
         ACTION 37: HTTP POST to make.com webhook
    -->
    <Action sr="act37" ve="7">
      <code>339</code>
      <Str sr="arg0" ve="3" val="POST" />
      <Str sr="arg1" ve="3" val="%MAKE_WEBHOOK_URL" />
      <!-- Headers -->
      <Str sr="arg2" ve="3" val="Content-Type:application/json" />
      <!-- Request body -->
      <Str sr="arg3" ve="3" val="%json_payload" />
      <Str sr="arg4" ve="3" val="application/json" />
      <!-- Output variable -->
      <Str sr="arg5" ve="3" val="%make_response" />
      <Int sr="arg6" val="0" />
      <Int sr="arg7" val="30" />
    </Action>

    <!-- ============================================================
         ACTION 38: Parse response and show result notification
    -->
    <Action sr="act38" ve="7">
      <code>664</code>
      <Str sr="arg0" ve="3" val="
var raw = make_response;
var msg = 'Splitwise updated!';
try {
  var resp = JSON.parse(raw);
  if (resp.success) {
    msg = resp.summary || 'Expense created successfully!';
  } else {
    msg = 'Error: ' + (resp.error || 'Unknown error from make.com');
  }
} catch(e) {
  msg = 'Response: ' + raw.substring(0, 100);
}
setLocal('result_msg', msg);
      " />
      <Str sr="arg1" ve="3" val="make_response" />
      <Str sr="arg2" ve="3" val="result_msg" />
      <Int sr="arg3" val="0" />
    </Action>

    <!-- Flash toast with result -->
    <Action sr="act39" ve="7">
      <code>524</code>
      <Str sr="arg0" ve="3" val="%result_msg" />
      <Int sr="arg1" val="1" />
    </Action>

    <!-- Persistent notification -->
    <Action sr="act40" ve="7">
      <code>522</code>
      <!-- Notify -->
      <Str sr="arg0" ve="3" val="Splitwise" />
      <Str sr="arg1" ve="3" val="%result_msg" />
      <Str sr="arg2" ve="3" val="" />
      <Int sr="arg3" val="0" />
      <Int sr="arg4" val="5" />
      <Str sr="arg5" ve="3" val="" />
    </Action>

  </Task>
</TaskerData>
